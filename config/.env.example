# Copy to .env for local runs. In CI these are GitHub Actions secrets.
# NEVER commit the real .env.

# --- Scraping ---
APIFY_TOKEN=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
REED_API_KEY=
SERPER_API_KEY=

# --- LLM scoring ---
GEMINI_API_KEY=
# Optional 2nd provider (recommended): free + fast, much higher limits than
# Gemini free tier. Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# --- Google Sheets (service account) ---
# Paste the FULL service-account JSON on one line, or point to a file path.
GOOGLE_SHEETS_CREDENTIALS=
# The spreadsheet id (from its URL) OR title. setup_tracker.py writes this out.
JOBRADAR_SHEET_ID=

# --- Gmail digest (SMTP app password) ---
GMAIL_SENDER=you@gmail.com
GMAIL_APP_PASSWORD=
GMAIL_RECIPIENT=you@gmail.com

# --- Gmail alerts reader (OAuth token JSON, optional source) ---
GMAIL_OAUTH_TOKEN=
